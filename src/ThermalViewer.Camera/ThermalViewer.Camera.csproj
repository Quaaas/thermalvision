<Project Sdk="Microsoft.NET.Sdk">

  <!-- Camera I/O: USB control transfers and isochronous video streaming via libusb-1.0,
       accessed through a thin own P/Invoke layer (see Interop/). No NuGet dependency:
       LibUsbDotNet 3.x was dropped because it doesn't support isochronous transfers.
       The native libusb-1.0 library must be installed on the system (see README). -->
  <PropertyGroup>
    <AssemblyName>ThermalViewer.Camera</AssemblyName>
    <RootNamespace>ThermalViewer.Camera</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThermalViewer.Core\ThermalViewer.Core.csproj" />
  </ItemGroup>

</Project>
