# udev rule so the Vantrue POWER TS1 (VID:PID 3474:45e1) can be accessed via libusb
# without root privileges.
#
# Install:
#   sudo cp 99-thermalviewer.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Then re-plug the camera. TAG+="uaccess" grants the logged-in user access; MODE="0666"
# is the fallback without systemd-logind. No GROUP=: on Arch/CachyOS "plugdev" doesn't
# exist, and an unresolvable group makes udev drop the whole rule line (including MODE).

SUBSYSTEM=="usb", ATTR{idVendor}=="3474", ATTR{idProduct}=="45e1", MODE="0666", TAG+="uaccess"
